<p><span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mtable width="100%"><mtr><mtd width="50%"></mtd><mtd><mrow><msub><mi>P</mi><mn>2</mn></msub><mo>=</mo><mn>100</mn><mo stretchy="false">[</mo><mi>B</mi><mo>+</mo><mstyle displaystyle="false" scriptlevel="0"><mfrac><mn>2</mn><mn>3</mn></mfrac></mstyle><mo stretchy="false">(</mo><mi>A</mi><mo>−</mo><mi>B</mi><mo stretchy="false">)</mo><mo stretchy="false">]</mo><mi mathvariant="normal">/</mi><mo stretchy="false">(</mo><mn>4</mn><msub><mover accent="true"><mi>S</mi><mo>ˉ</mo></mover><mi>x</mi></msub><mo stretchy="false">)</mo></mrow></mtd><mtd width="50%"></mtd><mtd><mtext>(3.10s)</mtext></mtd></mtr></mtable><annotation encoding="application/x-tex">P_2=100[B+\tfrac23(A-B)]/(4\bar S_x)\tag{3.10s}</annotation></semantics></math></span></p>
