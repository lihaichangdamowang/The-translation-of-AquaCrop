<p><span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mtable width="100%"><mtr><mtd width="50%"></mtd><mtd><mrow><mn>0</mn><mo>≤</mo><mi>τ</mi><mo>=</mo><mn>0.0866</mn><msubsup><mi>K</mi><mrow><mi>s</mi><mi>a</mi><mi>t</mi></mrow><mn>0.35</mn></msubsup><mo>≤</mo><mn>1</mn></mrow></mtd><mtd width="50%"></mtd><mtd><mtext>(3.7b)</mtext></mtd></mtr></mtable><annotation encoding="application/x-tex">0\le\tau=0.0866K_{sat}^{0.35}\le1\tag{3.7b}</annotation></semantics></math></span></p>
