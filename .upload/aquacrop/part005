<p><span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mtable width="100%"><mtr><mtd width="50%"></mtd><mtd><mrow><msub><mi>F</mi><mi>j</mi></msub><mo>=</mo><mfrac><mn>100</mn><msub><mi>L</mi><mrow><mi>f</mi><mi>l</mi><mi>o</mi><mi>w</mi><mi>e</mi><mi>r</mi><mi>i</mi><mi>n</mi><mi>g</mi></mrow></msub></mfrac><msub><mover accent="true"><mi>f</mi><mo>ˉ</mo></mover><mi>j</mi></msub></mrow></mtd><mtd width="50%"></mtd><mtd><mtext>(3.12j/2)</mtext></mtd></mtr></mtable><annotation encoding="application/x-tex">F_j=\frac{100}{L_{flowering}}\bar f_j\tag{3.12j/2}</annotation></semantics></math></span></p>
