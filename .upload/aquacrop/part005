<p><span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mtable width="100%"><mtr><mtd width="50%"></mtd><mtd><mrow><mi>K</mi><msub><mi>s</mi><mrow><mi>W</mi><mi>P</mi><mo separator="true">,</mo><mi>i</mi></mrow></msub><mo>=</mo><mn>1</mn><mo>−</mo><msub><mi>f</mi><mrow><mi>W</mi><mi>P</mi></mrow></msub><msup><mrow><mo fence="true">[</mo><mfrac><mrow><munderover><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></munderover><mo stretchy="false">(</mo><mi>T</mi><msub><mi>r</mi><mi>j</mi></msub><mi mathvariant="normal">/</mi><mi>E</mi><mi>T</mi><msub><mi>o</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow><mrow><munderover><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mo stretchy="false">(</mo><mi>T</mi><msub><mi>r</mi><mrow><mi>x</mi><mo separator="true">,</mo><mi>j</mi></mrow></msub><mi mathvariant="normal">/</mi><mi>E</mi><mi>T</mi><msub><mi>o</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mfrac><mo fence="true">]</mo></mrow><mn>2</mn></msup></mrow></mtd><mtd width="50%"></mtd><mtd><mtext>(3.11i)</mtext></mtd></mtr></mtable><annotation encoding="application/x-tex">Ks_{WP,i}=1-f_{WP}\left[\frac{\sum_{j=1}^i(Tr_j/ETo_j)}{\sum_{j=1}^n(Tr_{x,j}/ETo_j)}\right]^2\tag{3.11i}</annotation></semantics></math></span></p>
