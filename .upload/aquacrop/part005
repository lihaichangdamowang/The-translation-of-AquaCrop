<p><span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mtable width="100%"><mtr><mtd width="50%"></mtd><mtd><mrow><msub><mi>c</mi><mi>i</mi></msub><mo>=</mo><mo stretchy="false">(</mo><mi>C</mi><msub><mi>C</mi><mi>x</mi></msub><mo>−</mo><mi>C</mi><msub><mi>C</mi><mi>i</mi></msub><mo stretchy="false">)</mo><mi mathvariant="normal">/</mi><mo stretchy="false">(</mo><mn>0.1</mn><mi>C</mi><msub><mi>C</mi><mi>x</mi></msub><mo stretchy="false">)</mo><mo separator="true">,</mo><mspace width="1em"/><mi>C</mi><msub><mi>C</mi><mi>i</mi></msub><mo>&gt;</mo><mn>0.9</mn><mi>C</mi><msub><mi>C</mi><mi>x</mi></msub></mrow></mtd><mtd width="50%"></mtd><mtd><mtext>(3.11w)</mtext></mtd></mtr></mtable><annotation encoding="application/x-tex">c_i=(CC_x-CC_i)/(0.1CC_x),\quad CC_i&gt;0.9CC_x\tag{3.11w}</annotation></semantics></math></span></p>
