<p><span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mtable width="100%"><mtr><mtd width="50%"></mtd><mtd><mrow><mi>t</mi><mo>=</mo><mo stretchy="false">(</mo><msub><mi>B</mi><mrow><mi>m</mi><mi>o</mi><mi>b</mi><mo separator="true">,</mo><mi>n</mi></mrow></msub><mo>−</mo><mo>∑</mo><msub><mi>m</mi><mrow><mi>m</mi><mi>o</mi><mi>b</mi><mo separator="true">,</mo><mi>i</mi></mrow></msub><mo stretchy="false">)</mo><mi mathvariant="normal">/</mi><msub><mi>B</mi><mrow><mi>m</mi><mi>o</mi><mi>b</mi><mo separator="true">,</mo><mi>n</mi></mrow></msub></mrow></mtd><mtd width="50%"></mtd><mtd><mtext>(3.11v)</mtext></mtd></mtr></mtable><annotation encoding="application/x-tex">t=(B_{mob,n}-\sum m_{mob,i})/B_{mob,n}\tag{3.11v}</annotation></semantics></math></span></p>
