<p><span class="katex"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mtable width="100%"><mtr><mtd width="50%"></mtd><mtd><mrow><mi>C</mi><mi>D</mi><msub><mi>C</mi><mrow><mi>a</mi><mi>d</mi><mi>j</mi></mrow></msub><mo>=</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>K</mi><msubsup><mi>s</mi><mrow><mi>s</mi><mi>e</mi><mi>n</mi></mrow><mn>8</mn></msubsup><mo stretchy="false">)</mo><mi>C</mi><mi>D</mi><mi>C</mi></mrow></mtd><mtd width="50%"></mtd><mtd><mtext>(3.5f)</mtext></mtd></mtr></mtable><annotation encoding="application/x-tex">CDC_{adj}=(1-Ks_{sen}^{8})CDC\tag{3.5f}</annotation></semantics></math></span></p>
